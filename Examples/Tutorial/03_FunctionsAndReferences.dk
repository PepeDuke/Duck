// EXPECT: 10, then 6.
// PITFALL: a mutating argument uses &, rather than assuming value arguments
// modify the caller. Function inputs and returned values have explicit types.
int Double(int value)
{
    return value * 2
}

Increment(int& value)
{
    value++
}

Main()
{
    int value = 5
    Print(Double(value))
    Increment(value)
    Print(value)
}
