file(SHA256 "${LIBRARY}" NET_HASH)
file(READ "${INPUT}" remaining)
# MSVC limits a single string literal to 16 KiB.
set(NET_INTERFACE "")
string(LENGTH "${remaining}" length)
while(length GREATER 0)
  string(SUBSTRING "${remaining}" 0 8000 chunk)
  string(APPEND NET_INTERFACE "R\"DUCK(${chunk})DUCK\"\n")
  if(length LESS_EQUAL 8000)
    break()
  endif()
  string(SUBSTRING "${remaining}" 8000 -1 remaining)
  string(LENGTH "${remaining}" length)
endwhile()
configure_file("${TEMPLATE}" "${OUTPUT}" @ONLY)
