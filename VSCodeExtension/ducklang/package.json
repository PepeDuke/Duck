{
    "name": "ducklang",
    "displayName": "Duck Language",
    "description": "Syntax highlighting, snippets, and compiler diagnostics for the Duck language (.dk) and Duck projects (.dkp).",
    "version": "0.1.0",
    "publisher": "ducklang",
    "engines": {
        "vscode": "^1.69.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "duck",
        "dk",
        "dkp"
    ],
    "contributes": {
        "languages": [
            {
                "id": "duck",
                "aliases": [
                    "Duck",
                    "duck"
                ],
                "extensions": [
                    ".dk"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "duck-project",
                "aliases": [
                    "Duck Project",
                    "dkp"
                ],
                "extensions": [
                    ".dkp"
                ],
                "configuration": "./language-configuration-dkp.json"
            }
        ],
        "grammars": [
            {
                "language": "duck",
                "scopeName": "source.dk",
                "path": "./syntaxes/dk.tmGrammar.json"
            },
            {
                "language": "duck-project",
                "scopeName": "source.dkp",
                "path": "./syntaxes/dkp.tmGrammar.json"
            }
        ],
        "snippets": [
            {
                "language": "duck",
                "path": "./snippets/snippets.code-snippets"
            },
            {
                "language": "duck-project",
                "path": "./snippets/dkp.code-snippets"
            }
        ],
        "problemMatchers": [
            {
                "name": "duck",
                "label": "Duck compiler and test failures",
                "owner": "duck",
                "source": "duck",
                "applyTo": "allDocuments",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "severity": "error",
                "pattern": {
                    "regexp": "^(.+\\.dk):(\\d+):(\\d+): (?:(error|warning): )?(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        ]
    }
}
