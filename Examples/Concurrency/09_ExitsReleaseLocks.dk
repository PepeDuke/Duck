// EXPECT: 3, then 2, then 8.
// PITFALL: return, break, and continue all leave the $ block, and each of
// them releases its locks. The same is true of a block inside a loop: it
// locks and unlocks once per iteration, not once around the whole loop.
Stock
#{
    int Count = 3
}

int Take()
{
    ${
        if Stock.Count == 0
            return -1
        Stock.Count--
        return Stock.Count + 1
    }
}

Main()
{
    Print(Take())
    Print(Take())
    int total = 0
    for i : 1...100
    {
        ${
            if i == 2
                continue
            if i == 5
                break
            total += i
            Stock.Count++
        }
    }
    Print(total)
}
