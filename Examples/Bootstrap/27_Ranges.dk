// a...b includes both endpoints and counts toward b, up or down.
// Outside a for header it builds a dynamic array of its values.
// EXPECT: 0, 1, 2, 2, 1, 0, 30, 3, 3, 0, 3.
Main()
{
    for i : 0...2
        Print(i)
    for i : 2...0
        Print(i)

    int [] prices = {10, 20}
    int total = 0
    for i : 0...prices.Len-1
        total += prices[i]
    Print(total)

    steps : 5...3            // int [] {5, 4, 3}
    Print(steps.Len)
    Print(steps[2])

    // The endpoints are evaluated once; i is the counter itself, so a body
    // that changes it changes which values follow.
    for i : 0...4
    {
        Print(i)
        i += 2
    }
}
