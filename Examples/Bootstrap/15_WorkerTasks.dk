// Calls with known effects run as worker tasks. Output always matches
// sequential execution, whatever DUCK_WORKERS allows.

// Fib only computes with values and calls itself, so each call may run on
// another worker. The two recursive calls below overlap.
int Fib(int n)
{
    if n < 2
    {
        return n
    }
    left : Fib(n - 1)
    right : Fib(n - 2)
    return left + right
}

Calc
#{
    long Cube(int n)
    {
        return (long)n * n * n
    }
}

bool Even(int n)
{
    return n % 2 == 0
}

// Printing is an external effect: earlier tasks finish before it runs.
int Report(int n)
{
    Print(n)
    return n
}

Main()
{
    // Both calls start before either result is needed.
    long a = Fib(24)
    b : Calc.Cube(30)
    even : Even(7)
    Print(a)
    Print(b)
    Print(even)

    long total = 0
    for int i = 0; i < 4; i++
    {
        // Each iteration joins its task before the body's scope ends.
        square : Calc.Cube(i)
        twice : Fib(i + 10)
        total += square + twice
    }
    Print(total)

    first : Fib(20)
    shown : Report(1)
    second : Fib(21)
    Print(first + second + shown)
}
