// EXPECT: 15, 16, 25, 1.
// PITFALL: a macro used as a value is one expression, but its arguments still
// bind once. Square names `side` twice and Next() runs only one time.
// Macros are collected before parsing, so they can be declared anywhere
// outside a function, including after the code that calls them.
Counter
#{
    int Calls = 0

    int Next()
    {
        Calls++
        return 5
    }
}

Main()
{
    int size = 4
    Print(Area(size + 1, 3))
    Print(Square(size))
    Print(Square(Counter.Next()))
    Print(Counter.Calls)
}

macro Area(int width, int height) { width * height }
macro Square(int side) { side * side }
