/*
    Showcase of basic type conversion in Duck 
*/


// c++  Conversion From int to double
/*
    int main() {
    // assigning an int value to num_int
    int num_int = 9;

    // declaring a double type variable
    double num_double;
    
    // implicit conversion
    // assigning int value to a double variable
    num_double = num_int;

    cout << "num_int = " << num_int << endl;
    cout << "num_double = " << num_double << endl;

    return 0;
    }
*/


Main ()
{
    numInt : 9
    double numDouble
    // implicit conversion
    numDouble = numInt
    
    Print("num_int =" + numInt)
    Print("num_double =" + numDouble)
}